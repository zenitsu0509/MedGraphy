      "mode": "allopathy",
      "query": "What composition is listed for Augmentin 625 Duo Tablet?",
      "expected_medicines": ["Augmentin 625 Duo Tablet"],
      "required_context_fields": ["composition", "source_id", "provenance_status"],
      "required_answer_terms": ["amoxycillin", "clavulanic acid"]
    },
    {
      "id": "rag_allegra_side_effects",
